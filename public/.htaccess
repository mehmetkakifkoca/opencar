<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Direkt vorhandene Dateien und Ordner (z.B. PHP-Skripte, Bilder, CSS) normal ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Alle anderen URLs an index.html weiterleiten (React Router SPA)
  RewriteRule ^ index.html [L]
</IfModule>
